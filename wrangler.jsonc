{
  "name": "maxdom",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-20",
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    // preview_database_id keeps the local database where it has always been stored
    { "binding": "DB", "database_name": "maxdom", "database_id": "90ac6468-35bd-44a2-8cff-49428b7b2564", "preview_database_id": "local" }
  ],
  "triggers": { "crons": ["0 5 * * *", "0 6 * * 1"] },
  // Filled at deploy time from the Cloudflare Access application. Left empty, every API request is refused.
  "vars": { "ACCESS_TEAM_DOMAIN": "", "ACCESS_AUD": "" }
}
