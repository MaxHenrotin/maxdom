{
  "name": "maxdom",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "db:migrate": "wrangler d1 migrations apply maxdom --local",
    "db:backup": "wrangler d1 export maxdom --remote --output=data/backup-$(date +%F-%H%M).sql"
  },
  "devDependencies": {
    "vitest": "^5.0.5",
    "wrangler": "^4.151.2"
  }
}
